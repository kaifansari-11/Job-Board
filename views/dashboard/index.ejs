<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container">
    <div class="dashboard-header">
      <h1>Welcome, <%= user.name %></h1>
      <a href="/jobs/new" class="btn">+ Post a Job</a>
    </div>
    <h2>Your Job Listings</h2>
    <% if (jobs.length === 0) { %>
      <p>You haven't posted any jobs yet. <a href="/jobs/new">Post your first job</a></p>
    <% } else { %>
      <div class="jobs-grid">
        <% jobs.forEach(job => { %>
          <div class="job-card">
            <h2><%= job.title %></h2>
            <p class="company"><%= job.company %></p>
            <p class="location">📍 <%= job.location %></p>
            <a href="/jobs/<%= job.id %>" class="btn">View</a>
            <a href="/jobs/<%= job.id %>/edit" class="btn btn-secondary">Edit</a>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>