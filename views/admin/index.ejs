<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel — JobBoard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container">
    <div class="page-header">
      <div>
        <h1>Admin Panel</h1>
        <p>Manage all jobs, users and applications</p>
      </div>
    </div>

    <div class="admin-stats">
      <div class="stat-card">
        <span class="stat-num"><%= stats.totalJobs %></span>
        <span class="stat-label">Total Jobs</span>
      </div>
      <div class="stat-card">
        <span class="stat-num"><%= stats.totalUsers %></span>
        <span class="stat-label">Total Users</span>
      </div>
      <div class="stat-card">
        <span class="stat-num"><%= stats.totalApps %></span>
        <span class="stat-label">Applications</span>
      </div>
      <div class="stat-card">
        <span class="stat-num"><%= stats.totalEmployers %></span>
        <span class="stat-label">Employers</span>
      </div>
    </div>

    <div class="admin-table-wrap">
      <h2>All Job Listings</h2>
      <div style="overflow-x: auto; -webkit-overflow-scrolling: touch; width: 100%;">
        <table style="min-width: 800px;"> <thead>
            <tr>
              <th>Title</th>
              <th>Company</th>
              <th>Posted By</th>
              <th>Location</th>
              <th>Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% jobs.forEach(job => { %>
            <tr>
              <td><strong><%= job.title %></strong></td>
              <td><%= job.company %></td>
              <td><%= job.employer_name %></td>
              <td><%= job.location %></td>
              <td><%= new Date(job.created_at).toLocaleDateString() %></td>
              <td>
                <form action="/admin/jobs/<%= job.id %>/delete" method="POST" style="display:inline;">
                  <button class="btn btn-danger btn-sm" onclick="return confirm('Delete this job and all its applications?')">Delete</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="admin-table-wrap">
      <h2>All Users</h2>
      <div style="overflow-x: auto; -webkit-overflow-scrolling: touch; width: 100%;">
        <table style="min-width: 600px;"> <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Joined</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
            <tr>
              <td><strong><%= u.name %></strong></td>
              <td><%= u.email %></td>
              <td><span class="status-badge status-<%= u.role === 'employer' ? 'reviewed' : u.role === 'admin' ? 'accepted' : 'pending' %>"><%= u.role %></span></td>
              <td><%= new Date(u.created_at).toLocaleDateString() %></td>
              <td>
                <% if (u.role !== 'admin') { %>
                <form action="/admin/users/<%= u.id %>/delete" method="POST" style="display:inline;">
                  <button class="btn btn-danger btn-sm" onclick="return confirm('Delete this user and all their data?')">Delete</button>
                </form>
                <% } else { %>
                  <span style="color:var(--muted); font-size:12px;">Protected</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>