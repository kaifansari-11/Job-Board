<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Profile — JobBoard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container">

    <% if (locals.success) { %>
      <div class="alert-success">✓ Profile updated successfully!</div>
    <% } %>

    <div class="profile-view-page">

      <!-- Header card -->
      <div class="pv-header-card">
        <div class="pv-avatar-wrap">
          <% if (profile.avatar_url) { %>
            <img src="<%= profile.avatar_url %>" alt="Avatar" class="pv-avatar-img"/>
          <% } else { %>
            <div class="pv-avatar-placeholder"><%= profile.name.charAt(0).toUpperCase() %></div>
          <% } %>
          <!-- Quick avatar upload -->
          <form action="/profile/upload-avatar" method="POST" enctype="multipart/form-data" class="avatar-upload-form">
            <label class="avatar-upload-btn" title="Change photo">
              📷
              <input type="file" name="avatar" accept="image/*" onchange="this.form.submit()" style="display:none"/>
            </label>
          </form>
        </div>

        <div class="pv-header-info">
          <h1><%= profile.name %></h1>
          <span class="role-badge"><%= profile.role %></span>
          <% if (profile.location) { %>
            <p class="pv-location">📍 <%= profile.location %></p>
          <% } %>
          <% if (profile.bio || profile.company_about) { %>
            <p class="pv-bio"><%= profile.bio || profile.company_about %></p>
          <% } %>
          <div class="profile-links">
            <% if (profile.linkedin)        { %><a href="<%= profile.linkedin %>"        target="_blank" class="link-btn">LinkedIn</a><% } %>
            <% if (profile.github)          { %><a href="<%= profile.github %>"          target="_blank" class="link-btn">GitHub</a><% } %>
            <% if (profile.portfolio)       { %><a href="<%= profile.portfolio %>"       target="_blank" class="link-btn">Portfolio</a><% } %>
            <% if (profile.company_website) { %><a href="<%= profile.company_website %>" target="_blank" class="link-btn">Website</a><% } %>
          </div>
        </div>

        <a href="/profile/edit" class="btn pv-edit-btn">✏️ Edit Profile</a>
      </div>

      <!-- Content -->
      <div class="pv-content">

        <% if (profile.role === 'seeker') { %>

          <% if (profile.skills) { %>
          <div class="pv-section">
            <h3>Skills</h3>
            <div class="skills-container" style="justify-content:flex-start;">
              <% profile.skills.split(',').forEach(s => { %>
                <span class="skill-tag"><%= s.trim() %></span>
              <% }) %>
            </div>
          </div>
          <% } %>

          <% if (profile.experience) { %>
          <div class="pv-section">
            <h3>Experience</h3>
            <p style="white-space:pre-wrap;"><%= profile.experience %></p>
          </div>
          <% } %>

          <% if (profile.education) { %>
          <div class="pv-section">
            <h3>Education</h3>
            <p style="white-space:pre-wrap;"><%= profile.education %></p>
          </div>
          <% } %>

          <!-- Resume -->
          <div class="pv-section">
            <h3>Resume</h3>
            <% if (profile.resume_url) { %>
              <div class="resume-box">
                <span>📄 Resume uploaded</span>
                <a href="<%= profile.resume_url %>" target="_blank" class="btn btn-sm">View Resume</a>
              </div>
            <% } else { %>
              <p style="color:var(--muted); margin-bottom:12px;">No resume uploaded yet.</p>
            <% } %>
            <form action="/profile/upload-resume" method="POST" enctype="multipart/form-data" class="resume-upload-form">
              <label class="resume-upload-label">
                <input type="file" name="resume" accept=".pdf" onchange="this.form.submit()"/>
                📎 <%= profile.resume_url ? 'Replace Resume (PDF)' : 'Upload Resume (PDF)' %>
              </label>
            </form>
          </div>

        <% } else { %>

          <% if (profile.industry || profile.company_size) { %>
          <div class="pv-section">
            <h3>Company Details</h3>
            <% if (profile.industry)     { %><p>🏢 Industry: <strong><%= profile.industry %></strong></p><% } %>
            <% if (profile.company_size) { %><p>👥 Size: <strong><%= profile.company_size %> employees</strong></p><% } %>
            <% if (profile.company_name) { %><p>🏷️ Company: <strong><%= profile.company_name %></strong></p><% } %>
          </div>
          <% } %>

        <% } %>

      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>