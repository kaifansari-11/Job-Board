<nav class="navbar">
  <a href="/" class="nav-brand">⚡ JobBoard</a>
  <div class="nav-links" id="navLinks">
    <% if (user) { %>
      <span>👋 <%= user.name %></span>
      <% if (user.role === 'admin') { %>
        <a href="/admin">Admin Panel</a>
      <% } else if (user.role === 'employer') { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/jobs/new">Post Job</a>
      <% } else { %>
        <a href="/jobs">Browse Jobs</a>
        <a href="/apply/my-applications">My Applications</a>
      <% } %>
      <% if (user.role !== 'admin') { %>
        <a href="/profile">Profile</a>
      <% } %>
      <a href="/auth/logout" class="btn btn-logout btn-sm">Logout</a>
    <% } else { %>
      <a href="/auth/login">Login</a>
      <a href="/auth/register" class="btn btn-sm">Get Started</a>
    <% } %>
  </div>
  <button class="nav-hamburger" id="hamburger" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="nav-mobile" id="navMobile">
  <% if (user) { %>
    <span>👋 <%= user.name %></span>
    <% if (user.role === 'admin') { %>
      <a href="/admin">Admin Panel</a>
    <% } else if (user.role === 'employer') { %>
      <a href="/dashboard">Dashboard</a>
      <a href="/jobs/new">Post Job</a>
    <% } else { %>
      <a href="/jobs">Browse Jobs</a>
      <a href="/apply/my-applications">My Applications</a>
    <% } %>
    <% if (user.role !== 'admin') { %>
      <a href="/profile">Profile</a>
    <% } %>
    <a href="/auth/logout">Logout</a>
  <% } else { %>
    <a href="/auth/login">Login</a>
    <a href="/auth/register">Register</a>
  <% } %>
</div>