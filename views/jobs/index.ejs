<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Jobs</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container">
    <h1>Available Jobs</h1>
    <% if (jobs.length === 0) { %>
      <p>No jobs posted yet.</p>
    <% } else { %>
      <div class="jobs-grid">
        <% jobs.forEach(job => { %>
          <div class="job-card">
            <h2><%= job.title %></h2>
            <p class="company"><%= job.company %></p>
            <p class="location">📍 <%= job.location %></p>
            <p class="posted-by">Posted by <%= job.employer_name %></p>
            <a href="/jobs/<%= job.id %>" class="btn">View Details</a>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>